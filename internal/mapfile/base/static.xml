		<Item href="#n:inline(AdvMapStatic)" id="{{ID}}">
			<AdvMapStatic>
				<Pos>
					<x>{{X}}</x>
					<y>{{Y}}</y>
					<z>0</z>
				</Pos>
				<Rot>{{ROT}}</Rot>
				<Floor>0</Floor>
				<Name/>
				<CombatScript/>
				<pointLights/>
				<Shared href="{{SHARED}}"/>
